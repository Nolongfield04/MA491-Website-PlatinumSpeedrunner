{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ma491-website-platinumspeedrunner",
  "main": "worker.js",
  "compatibility_date": "2026-09-02",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
